# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend URLs allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Where shared links (/share/books/:id) send people. Defaults to the first CLIENT_ORIGIN.
FRONTEND_URL=
# Set to true to also serve the built frontend (frontend/dist) from this server
SERVE_CLIENT=false

# --- MongoDB (local or MongoDB Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/a-read

# --- Auth ---
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated emails that get the admin role (can edit/delete any book)
ADMIN_EMAILS=

# --- Cloudinary (Dashboard > API Keys > "API environment variable") ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=a-read

# --- Upload limits (MB) ---
MAX_BOOK_MB=100
# Audio is stored as one file, so keep this within your Cloudinary plan's video limit (free: 100 MB)
MAX_AUDIO_MB=100
# Largest single file your Cloudinary plan accepts for PDFs/raw files (free plan: 10).
# Bigger books are stored as several parts and joined back together by the reader.
CLOUDINARY_MAX_FILE_MB=10
MAX_COVER_MB=5

# --- Email (Brevo) — confirmation links for new accounts, required-reading notices ---
# Brevo → SMTP & API → API Keys. Leave empty to skip email confirmation (accounts are active at once).
BREVO_API_KEY=
# A sender address verified in Brevo (Senders, Domains & Dedicated IPs → Senders)
EMAIL_FROM=
EMAIL_FROM_NAME=A-Read

# --- Sign in with Google (optional) ---
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: your frontend URL(s), e.g. https://a-read.vercel.app and http://localhost:5173
GOOGLE_CLIENT_ID=

# --- Google Cloud Text-to-Speech (optional, enables cloud narration) ---
# Path to a service-account JSON key with the Cloud Text-to-Speech API enabled
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_DEFAULT_VOICE=en-US-Neural2-F
# Refuse to narrate books longer than this many characters (cost guard)
NARRATION_MAX_CHARS=1500000

# --- M-Pesa (Safaricom Daraja: Lipa na M-Pesa Online / STK Push) ---
# developer.safaricom.co.ke → My Apps. Use "sandbox" until Safaricom approves go-live.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Short code used to sign requests: the store / head office number for a till (sandbox: 174379),
# or your Paybill number.
MPESA_SHORTCODE=
# Lipa na M-Pesa Online passkey (emailed by Safaricom at go-live; shown on the sandbox simulator)
MPESA_PASSKEY=
# The Buy Goods till customers pay into. Leave empty to charge the Paybill in MPESA_SHORTCODE instead.
MPESA_TILL_NUMBER=
# Public HTTPS address of this API (Safaricom posts payment results to it), e.g. https://a-read-api.onrender.com
MPESA_CALLBACK_BASE_URL=
# Long random string that makes the callback URL secret (same generator as JWT_SECRET)
MPESA_CALLBACK_SECRET=
# Shown on the payer's M-Pesa statement for Paybill payments (max 12 characters)
MPESA_ACCOUNT_REFERENCE=A-Read
MPESA_MIN_AMOUNT=10
MPESA_MAX_AMOUNT=150000
# Time zone for the popups' daily hours
TIME_ZONE=Africa/Nairobi

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend URLs allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Set to true to also serve the built frontend (frontend/dist) from this server
SERVE_CLIENT=false

# --- MongoDB (local or MongoDB Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/a-read

# --- Auth ---
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated emails that get the admin role (can edit/delete any book)
ADMIN_EMAILS=

# --- Cloudinary (Dashboard > API Keys > "API environment variable") ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=a-read

# --- Upload limits (MB). Your Cloudinary plan also caps file sizes. ---
MAX_BOOK_MB=50
MAX_AUDIO_MB=300
MAX_COVER_MB=5

# --- Google Cloud Text-to-Speech (optional, enables cloud narration) ---
# Path to a service-account JSON key with the Cloud Text-to-Speech API enabled
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_DEFAULT_VOICE=en-US-Neural2-F
# Refuse to narrate books longer than this many characters (cost guard)
NARRATION_MAX_CHARS=1500000

# URL of the backend API. Leave empty in development (Vite proxies /api to localhost:5000).
# In production set it to your deployed API, e.g. https://a-read-api.onrender.com/api
VITE_API_URL=
# Optional: per-file upload limit shown and checked in the browser (match MAX_BOOK_MB on the backend)
VITE_MAX_BOOK_MB=100

{
  "name": "A-Read: read and listen to books",
  "short_name": "A-Read",
  "description": "A shared library you can read on screen or listen to.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf7f2",

{
  "appId": "com.aread.app",
  "appName": "A-read",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "a-read.onrender.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": "always",
      "appId": "com.aread.app",
      "keepUrlPathAfterReload": true,
      "version": "0.0.0",
      "defaultChannel": "production",
      "autoSplashscreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "SplashScreen": {
      "launchAutoHide": false
    }
  }
}

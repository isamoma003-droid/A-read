{
  "appId": "com.aread.app",
  "appName": "A-read",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "a-read.onrender.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
